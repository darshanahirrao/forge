{
  "name": "@forge-workspace/forge",
  "version": "0.29.0",
  "description": "A local workspace for continuous work across agent harnesses.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "forge": "bin/forge.mjs"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc -p tsconfig.server.json && node bin/copy-native-assets.mjs && vite build",
    "start": "node dist/server/index.js",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json",
    "format": "prettier --write --ignore-unknown web server shared tests bin *.json *.ts",
    "format:check": "prettier --check --ignore-unknown web server shared tests bin *.json *.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:package": "node --test tests/package.test.mjs",
    "test:native:codex": "tsx tests/native/codex-conformance.ts",
    "test:native:claude": "tsx tests/native/claude-conformance.ts",
    "test:native:handoff": "tsx tests/native/handoff-conformance.ts",
    "test:native:inventory": "tsx tests/native/inventory-conformance.ts --existing",
    "test:native:scheduler": "tsx tests/native/scheduler-conformance.ts",
    "test:native:credentials": "tsx tests/native/credential-conformance.ts",
    "test:native:controls": "tsx tests/native/control-conformance.ts",
    "test:native:connector": "tsx tests/native/connector-conformance.ts",
    "test:native": "npm run test:native:codex && npm run test:native:claude && npm run test:native:opencode && npm run test:native:hermes && npm run test:native:openclaw && npm run test:native:handoff",
    "test:native:opencode": "tsx tests/native/opencode-conformance.ts",
    "test:native:hermes": "tsx tests/native/hermes-conformance.ts",
    "test:native:openclaw": "tsx tests/native/openclaw-conformance.ts",
    "test:native:service": "node tests/native/service-conformance.mjs",
    "test:native:availability": "node tests/native/availability-conformance.mjs",
    "test:native:pressure": "node tests/native/pressure-conformance.mjs",
    "test:native:resources": "node tests/native/resource-conformance.mjs",
    "test:native:recovery": "tsx tests/native/recovery-conformance.ts",
    "test:native:t3": "tsx tests/native/t3-conformance.ts",
    "test:native:t3-execution": "tsx tests/native/t3-execution-conformance.ts",
    "test:native:companion": "tsx tests/native/companion-conformance.ts",
    "test:native:memory-packs": "tsx tests/native/companion-conformance.ts --portable-memory"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "@fastify/http-proxy": "11.6.4",
    "@fastify/static": "^10.1.6",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openclaw/gateway-client": "2026.10.4",
    "@opencode/client": "2.0.6",
    "fastify": "^5.6.0",
    "lucide-react": "^0.577.0",
    "markdown-it": "15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smol-toml": "1.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
